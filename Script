-- Create Toggle Function
local function CreateToggle(name, key, defaultState, callback)
    local state = defaultState
    local Frame = Instance.new("Frame", ContentList)
    Frame.Size, Frame.BackgroundColor3 = UDim2.new(1, 0, 0, 38), Color3.fromRGB(15, 25, 35)
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", Frame)
    s.Thickness, s.Color = 1, Color3.fromRGB(0, 100, 100)

    local Label = Instance.new("TextLabel", Frame)
    Label.Size, Label.Position, Label.BackgroundTransparency = UDim2.new(1, -65, 1, 0), UDim2.new(0, 10, 0, 0), 1
    Label.Font, Label.Text, Label.TextColor3, Label.TextSize = Enum.Font.GothamMedium, name, Color3.fromRGB(200, 255, 240), 11
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local SwitchBG = Instance.new("Frame", Frame)
    SwitchBG.Size, SwitchBG.Position, SwitchBG.AnchorPoint = UDim2.new(0, 42, 0, 20), UDim2.new(1, -8, 0.5, 0), Vector2.new(1, 0.5)
    SwitchBG.BackgroundColor3 = state and Color3.fromRGB(0, 255, 200) or Color3.fromRGB(40, 50, 60)
    Instance.new("UICorner", SwitchBG).CornerRadius = UDim.new(1, 0)

    local Dot = Instance.new("Frame", SwitchBG)
    Dot.Size, Dot.Position, Dot.AnchorPoint = UDim2.new(0, 16, 0, 16), state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0), Vector2.new(0, 0.5)
    Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)

    local Button = Instance.new("TextButton", Frame)
    Button.Size, Button.BackgroundTransparency, Button.Text = UDim2.new(1, 0, 1, 0), 1, ""

    local function SetState(newState)
        state = newState
        callback(state)
        TweenService:Create(Dot, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)}):Play()
        TweenService:Create(SwitchBG, TweenInfo.new(0.2), {BackgroundColor3 = state and Color3.fromRGB(0, 255, 200) or Color3.fromRGB(40, 50, 60)}):Play()
    end
    ToggleSetters[key] = SetState
    Button.MouseButton1Click:Connect(function() SetState(not state) end)
end

-- Create Slider Function
local function CreateSlider(name, min, max, default, callback)
    local val = default
    local Frame = Instance.new("Frame", ContentList)
    Frame.Size, Frame.BackgroundColor3 = UDim2.new(1, 0, 0, 48), Color3.fromRGB(15, 25, 35)
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

    local Label = Instance.new("TextLabel", Frame)
    Label.Size, Label.Position, Label.BackgroundTransparency = UDim2.new(1, -20, 0, 16), UDim2.new(0, 10, 0, 4), 1
    Label.Font, Label.Text, Label.TextColor3, Label.TextSize = Enum.Font.GothamMedium, name .. ": " .. tostring(val), Color3.fromRGB(200, 255, 240), 10
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local SliderBar = Instance.new("Frame", Frame)
    SliderBar.Size, SliderBar.Position, SliderBar.BackgroundColor3 = UDim2.new(1, -20, 0, 6), UDim2.new(0, 10, 0, 28), Color3.fromRGB(30, 40, 50)
    Instance.new("UICorner", SliderBar).CornerRadius = UDim.new(1, 0)

    local FillBar = Instance.new("Frame", SliderBar)
    FillBar.Size, FillBar.BackgroundColor3 = UDim2.new((val - min)/(max - min), 0, 1, 0), Color3.fromRGB(0, 255, 200)
    Instance.new("UICorner", FillBar).CornerRadius = UDim.new(1, 0)

    local SliderBtn = Instance.new("TextButton", Frame)
    SliderBtn.Size, SliderBtn.BackgroundTransparency, SliderBtn.Text = UDim2.new(1, 0, 1, 0), 1, ""

    local Sliding = false
    local function UpdateSlider(input)
        local posX = math.clamp(input.Position.X - SliderBar.AbsolutePosition.X, 0, SliderBar.AbsoluteSize.X)
        local percentage = posX / SliderBar.AbsoluteSize.X
        val = math.floor(min + (max - min) * percentage)
        Label.Text = name .. ": " .. tostring(val)
        FillBar.Size = UDim2.new(percentage, 0, 1, 0)
        callback(val)
    end
    SliderBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then Sliding = true UpdateSlider(input) end
    end)
    SliderBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then Sliding = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if Sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then UpdateSlider(input) end
    end)
end

