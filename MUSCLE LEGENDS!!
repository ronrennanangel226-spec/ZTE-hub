-- AUTO DETECT BOSS / AUTO SWITCH LOOP
-- ============================================

task.spawn(function()
    local lastBossState = false

    while task.wait(0.5) do
        local boss = FindBoss()
        local bossExists = false

        if boss then
            local hp = GetHealth(boss)
            if hp and hp > 0 then
                bossExists = true
            end
        end

        -- State change detected
        if bossExists ~= lastBossState then
            lastBossState = bossExists

            if bossExists then
                -- Boss detected: Stop Auto Farm, Start Auto Boss
                SetAutoFarmState(false)
                SetAllToggles(true)
                print("⚡ Boss detected! Switching to Auto Boss...")
            else
                -- Boss gone: Stop Auto Boss, Resume Auto Farm
                SetAllToggles(false)
                SetAutoFarmState(true)
                print("⚡ Boss defeated/despawned! Resuming Auto Farm...")
            end
        end
    end
end)

